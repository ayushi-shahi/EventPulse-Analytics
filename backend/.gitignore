# backend/.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables
.env
.env.local
.env.*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Database
*.db
*.sqlite3

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Alembic
# Don't ignore alembic/ folder, but ignore __pycache__
alembic/__pycache__/
alembic/versions/__pycache__/

# Scratch test scripts dropped in the backend root.
# Anchored with a leading slash — unanchored, this matched every path segment
# and quietly kept the whole tests/ suite out of version control.
/test_*.py

dump.rdb
*.rdb
# Celery runtime files (regenerate on docker-compose up)
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
celeryd.pid

# ... rest of your existing .gitignore